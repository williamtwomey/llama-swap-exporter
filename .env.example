# Per-host overrides for docker-compose.yml. Copy to .env on the host.
#
# Only needed on hosts where llama-swap does not listen on the 8080 default.
# Note that pointing the exporter at the wrong port does NOT always fail
# cleanly: if some other service answers that port (even with an HTTP error),
# the exporter starts, serves :9820, and reports llamaswap_up 0 while looking
# superficially healthy. See "Deployment" in README.md.
#
# LLAMASWAP_URL=http://127.0.0.1:8089

# LLAMASWAP_API_KEY=
# POLL_INTERVAL=15
